FROM python:3.12-slim
WORKDIR /service
COPY pyproject.toml ./
COPY app ./app
RUN pip install --no-cache-dir . && useradd --uid 10001 --create-home ripple && mkdir /data && chown ripple /data
USER ripple
ENV RIPPLE_RELAY_BIND=0.0.0.0 RIPPLE_RELAY_PORT=18801 RIPPLE_RELAY_DATA_DIR=/data PYTHONDONTWRITEBYTECODE=1
EXPOSE 18801
CMD ["python", "-m", "app.connection_service"]
